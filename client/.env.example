# 前端环境变量配置示例
# 复制此文件为 .env 并填入实际的URL

# 环境配置 - 设置为 'development' 或 'production'
REACT_APP_ENV=development

# 开发环境配置
REACT_APP_BACKEND_URL_DEV=http://localhost:8000/
REACT_APP_SOCKET_URL_DEV=ws://localhost:8000

# 生产环境配置  
REACT_APP_BACKEND_URL_PROD=your-production-backend-url/
REACT_APP_SOCKET_URL_PROD=your-production-websocket-url